# Postgres
DATABASE_URL=postgresql+psycopg://inverse:inverse@localhost:5432/inverse

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# OpenAI (chat + embeddings)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Free Law Project / CourtListener
COURTLISTENER_API_TOKEN=

# GovInfo / Congress.gov — GOVINFO_API_KEY defaults to the public DEMO_KEY (low rate
# limits) if left blank; get a free key at https://api.data.gov/signup for real volume.
GOVINFO_API_KEY=
CONGRESS_GOV_API_KEY=

# Tavily (live web verification — discovery-tier only, never legal authority)
TAVILY_API_KEY=

APP_ENV=development
